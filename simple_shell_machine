def print_menu():
    print(" MCHEMBE FUEL STATION")
    print("1. Petrol - 3500 per liter")
    print("2. Diesel - 3400 per liter")
    print("3. Exit")
    


import time

def get_fuel_choice():
    choice = input("Choose fuel type (1-3): ").strip()
    return choice


def get_money():
    while True:
        value = input("Enter amount of money: ").strip()
        try:
            amount = float(value)
            if amount <= 0:
                print("Please enter a positive amount.")
                continue
            return amount
        except ValueError:
            print("Invalid input. Please enter a number.")


def calculate_liters(amount, price_per_liter):
    return amount / price_per_liter


def show_money_count(amount):
    print("\nCounting money from 0 to the entered amount:")
    target = amount
    if target <= 0:
        print("0.00\n")
        return

    duration = 30.0
    steps = 300
    delay = duration / steps

    for step in range(steps + 1):
        current = target * step / steps
        print(f"\r{current:.2f}", end="", flush=True)
        time.sleep(delay)

    print(f"\r{target:.2f}\n", flush=True)


def main():
    prices = {
        "1": ("Petrol", 3500),
        "2": ("Diesel", 3500),
       
    }

    while True:
        print_menu()
        choice = get_fuel_choice()

        if choice == "3":
            print("Thank you for visiting. Goodbye!")
            break

        if choice not in prices:
            print("Invalid choice. Please choose 1, 2, or 3.")
            continue

        fuel_name, price = prices[choice]
        amount = get_money()
        show_money_count(amount)
        liters = calculate_liters(amount, price)

        print(f"You selected {fuel_name}.")
        print(f"Amount paid: {amount:.2f}")
        print(f"Price per liter: {price:.2f}")
        print(f"Liters delivered: {liters:.3f} L\n")

        again = input("Would you like another transaction? (yes/no): ").strip().lower()
        if again not in ("yes", "y"):
            print("Thank you for using the Shell fuel station machine.")
            break


if __name__ == "__main__":
    main()
